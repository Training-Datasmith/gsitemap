{
  "name": "prestashop/gsitemap",
  "description": "PrestaShop module gsitemap",
  "homepage": "https://github.com/PrestaShop/gsitemap",
  "license": "AFL-3.0",
  "authors": [
    {
      "name": "PrestaShop SA",
      "email": "contact@prestashop.com"
    }
  ],
  "require": {
    "php": ">=5.6.0"
  },
  "require-dev": {
    "prestashop/php-dev-tools": "^3.4",
    "phpunit/phpunit": "5.7.27",
    "phpunit/php-token-stream": "<2"
  },
  "config": {
    "preferred-install": "dist",
    "prepend-autoloader": false,
    "platform": {
      "php": "5.6.40"
    }
  },
  "type": "prestashop-module",
  "autoload": {
    "classmap": [
      "gsitemap.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "GsitemapTests\\Unit\\": "tests/Unit/",
      "GsitemapTests\\Support\\": "tests/Support/"
    },
    "classmap": [
      "tests/TestCase.php"
    ]
  }
}
